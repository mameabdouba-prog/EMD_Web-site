# ==============================================================
# Configuration backend Django - Groupe Scolaire EMD
# Copier ce fichier en ".env" puis remplir les valeurs réelles.
# Le fichier .env ne doit JAMAIS être commité dans git.
# ==============================================================

# --- Django ---
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# false en production
DEBUG=false
# Domaines autorisés, séparés par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Sécurité production (derrière HTTPS) ---
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# --- Cloudinary (stockage des images uploadées) ---
# Requis en production : sans ces variables, les images sont stockées sur le
# disque éphémère de Render et disparaissent à chaque redéploiement.
# Créer un compte sur https://cloudinary.com puis renseigner depuis le dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Compte administrateur de l'API (dashboard React) ---
ADMIN_API_USERNAME=admin
# Hash PBKDF2 du mot de passe. NE JAMAIS mettre le mot de passe en clair ici.
# Générer le hash :
#   python manage.py shell -c "from django.contrib.auth.hashers import make_password; print(make_password('VOTRE_MOT_DE_PASSE'))"
ADMIN_API_PASSWORD_HASH=
# Durée de vie du token admin en secondes (8h par défaut)
ADMIN_TOKEN_MAX_AGE=28800

# --- Email SMTP ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
# Mot de passe d'application Gmail (16 caractères) - généré depuis le compte Google
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Site EMD <votre-email@gmail.com>
EMAIL_RECEIVER=votre-email@gmail.com

# --- Frontend (fichier frontend/.env) ---
VITE_API_URL=http://localhost:8000/api

# --- Admin API Authentication ---
# Identifiants pour le tableau de bord administrateur
ADMIN_API_USERNAME=admin
# Hash du password (pbkdf2_sha256). Générer avec: python manage.py shell -c "from django.contrib.auth.hashers import make_password; print(make_password('MOT_DE_PASSE'))"
ADMIN_API_PASSWORD_HASH=pbkdf2_sha256$720000$eV3KqGHmg1gJ0Z8X$l3RhQBd52D8Z8X/Y8l3RhQBd52D8Z8X/Y8l3RhQBd52D8=
# Durée de vie du token admin en secondes (28800 = 8 heures)
ADMIN_TOKEN_MAX_AGE=28800
